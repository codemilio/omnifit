# --- Telegram ---
# Token obtido em @BotFather
BOT_TOKEN=

# --- Banco ---
# Usado pelo bot/api (driver async)
DATABASE_URL=postgresql+asyncpg://omnifit:omnifit@db:5432/omnifit
# Usado pelo container postgres
POSTGRES_USER=omnifit
POSTGRES_PASSWORD=omnifit
POSTGRES_DB=omnifit

# --- IA (Groq) ---
# https://console.groq.com/keys
GROQ_API_KEY=

# --- Aplicação ---
TZ=America/Sao_Paulo

# --- Dashboard / Caddy ---
DOMAIN=omnifit.duckdns.org
BASIC_AUTH_USER=admin
# Gerar com: docker run --rm caddy:2-alpine caddy hash-password --plaintext 'sua-senha'
BASIC_AUTH_HASH=
